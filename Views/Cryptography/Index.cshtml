@{
    ViewData["Title"] = "Mã hóa RSA";
}

<div class="container mt-4">
    <h2 class="mb-4">Mã hóa RSA</h2>

    <div class="row mb-4">
        <div class="col-md-12">
            <div class="card">
                <div class="card-header">
                    <h5>Tạo khóa</h5>
                </div>
                <div class="card-body">
                    <button id="generateKeys" class="btn btn-primary">Tạo cặp khóa mới</button>
                    <div id="keyStatus" class="mt-2"></div>
                </div>
            </div>
        </div>
    </div>

    <div class="row mb-4">
        <div class="col-md-6">
            <div class="card">
                <div class="card-header">
                    <h5>Mã hóa văn bản</h5>
                </div>
                <div class="card-body">
                    <div class="form-group">
                        <label for="encryptText">Văn bản cần mã hóa:</label>
                        <textarea id="encryptText" class="form-control" rows="3"></textarea>
                    </div>
                    <button id="encryptBtn" class="btn btn-primary mt-2">Mã hóa</button>
                    <div class="form-group mt-3">
                        <label for="encryptedResult">Kết quả mã hóa:</label>
                        <textarea id="encryptedResult" class="form-control" rows="5" readonly></textarea>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card">
                <div class="card-header">
                    <h5>Giải mã văn bản</h5>
                </div>
                <div class="card-body">
                    <div class="form-group">
                        <label for="decryptText">Văn bản cần giải mã:</label>
                        <textarea id="decryptText" class="form-control" rows="5"></textarea>
                    </div>
                    <button id="decryptBtn" class="btn btn-primary mt-2">Giải mã</button>
                    <div class="form-group mt-3">
                        <label for="decryptedResult">Kết quả giải mã:</label>
                        <textarea id="decryptedResult" class="form-control" rows="3" readonly></textarea>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-6">
            <div class="card">
                <div class="card-header">
                    <h5>Ký văn bản</h5>
                </div>
                <div class="card-body">
                    <div class="form-group">
                        <label for="signText">Văn bản cần ký:</label>
                        <textarea id="signText" class="form-control" rows="3"></textarea>
                    </div>
                    <button id="signBtn" class="btn btn-primary mt-2">Ký</button>
                    <div class="form-group mt-3">
                        <label for="signatureResult">Chữ ký:</label>
                        <textarea id="signatureResult" class="form-control" rows="5" readonly></textarea>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card">
                <div class="card-header">
                    <h5>Xác thực chữ ký</h5>
                </div>
                <div class="card-body">
                    <div class="form-group">
                        <label for="verifyText">Văn bản cần xác thực:</label>
                        <textarea id="verifyText" class="form-control" rows="3"></textarea>
                    </div>
                    <div class="form-group mt-2">
                        <label for="verifySignature">Chữ ký:</label>
                        <textarea id="verifySignature" class="form-control" rows="5"></textarea>
                    </div>
                    <button id="verifyBtn" class="btn btn-primary mt-2">Xác thực</button>
                    <div id="verifyResult" class="mt-3 alert" style="display: none;"></div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            // Tạo cặp khóa mới
            $("#generateKeys").click(function () {
                $.ajax({
                    url: '@Url.Action("GenerateKeys", "Cryptography")',
                    type: 'POST',
                    success: function (result) {
                        if (result.success) {
                            $("#keyStatus").html('<div class="alert alert-success">' + result.message + '</div>');
                        } else {
                            $("#keyStatus").html('<div class="alert alert-danger">' + result.message + '</div>');
                        }
                    },
                    error: function () {
                        $("#keyStatus").html('<div class="alert alert-danger">Đã xảy ra lỗi khi tạo khóa!</div>');
                    }
                });
            });

            // Mã hóa văn bản
            $("#encryptBtn").click(function () {
                var text = $("#encryptText").val();
                if (!text) {
                    alert("Vui lòng nhập văn bản cần mã hóa!");
                    return;
                }

                $.ajax({
                    url: '@Url.Action("Encrypt", "Cryptography")',
                    type: 'POST',
                    data: { text: text },
                    success: function (result) {
                        if (result.success) {
                            $("#encryptedResult").val(result.encryptedText);
                        } else {
                            alert(result.message);
                        }
                    },
                    error: function () {
                        alert("Đã xảy ra lỗi khi mã hóa văn bản!");
                    }
                });
            });

            // Giải mã văn bản
            $("#decryptBtn").click(function () {
                var encryptedText = $("#decryptText").val();
                if (!encryptedText) {
                    alert("Vui lòng nhập văn bản cần giải mã!");
                    return;
                }

                $.ajax({
                    url: '@Url.Action("Decrypt", "Cryptography")',
                    type: 'POST',
                    data: { encryptedText: encryptedText },
                    success: function (result) {
                        if (result.success) {
                            $("#decryptedResult").val(result.decryptedText);
                        } else {
                            alert(result.message);
                        }
                    },
                    error: function () {
                        alert("Đã xảy ra lỗi khi giải mã văn bản!");
                    }
                });
            });

            // Ký văn bản
            $("#signBtn").click(function () {
                var text = $("#signText").val();
                if (!text) {
                    alert("Vui lòng nhập văn bản cần ký!");
                    return;
                }

                $.ajax({
                    url: '@Url.Action("Sign", "Cryptography")',
                    type: 'POST',
                    data: { text: text },
                    success: function (result) {
                        if (result.success) {
                            $("#signatureResult").val(result.signature);
                        } else {
                            alert(result.message);
                        }
                    },
                    error: function () {
                        alert("Đã xảy ra lỗi khi ký văn bản!");
                    }
                });
            });

            // Xác thực chữ ký
            $("#verifyBtn").click(function () {
                var text = $("#verifyText").val();
                var signature = $("#verifySignature").val();
                if (!text || !signature) {
                    alert("Vui lòng nhập đầy đủ văn bản và chữ ký cần xác thực!");
                    return;
                }

                $.ajax({
                    url: '@Url.Action("VerifySignature", "Cryptography")',
                    type: 'POST',
                    data: { text: text, signature: signature },
                    success: function (result) {
                        if (result.success) {
                            $("#verifyResult").removeClass().addClass("alert");
                            if (result.isVerified) {
                                $("#verifyResult").addClass("alert-success").text("Xác thực thành công! Chữ ký hợp lệ.");
                            } else {
                                $("#verifyResult").addClass("alert-danger").text("Xác thực thất bại! Chữ ký không hợp lệ.");
                            }
                            $("#verifyResult").show();
                        } else {
                            alert(result.message);
                        }
                    },
                    error: function () {
                        alert("Đã xảy ra lỗi khi xác thực chữ ký!");
                    }
                });
            });
        });
    </script>
} 