<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Quanlydiem</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Quanlydiem.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11.7.27/dist/sweetalert2.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">Quanlydiem</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="BlockchainIntegrity" asp-action="Index">
                                <i class="fas fa-shield-alt"></i> Kiểm tra tính toàn vẹn
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Cryptography" asp-action="Index">
                                <i class="fas fa-lock"></i> Mã hóa RSA
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="FileEncryption" asp-action="Index">
                                <i class="fas fa-file-alt"></i> Mã hóa File
                            </a>
                        </li>
                    </ul>
                    <div id="integrityCheck" class="ml-auto">
                        <!-- Cảnh báo tính toàn vẹn sẽ hiển thị ở đây -->
                    </div>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2025 - Quanlydiem - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11.7.27/dist/sweetalert2.all.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    
    <!-- Script để kiểm tra tính toàn vẹn blockchain -->
    <script>
        $(document).ready(function() {
            // Kiểm tra tính toàn vẹn blockchain mỗi 30 giây
            function checkBlockchainIntegrity() {
                $.ajax({
                    url: '@Url.Action("GetBlockchainIntegrityStatus", "BlockchainIntegrity")',
                    type: 'GET',
                    success: function(result) {
                        if (!result.isValid) {
                            // Hiển thị cảnh báo khi phát hiện block bị sửa đổi
                            $('#integrityCheck').html(
                                '<a href="@Url.Action("Index", "BlockchainIntegrity")" class="btn btn-danger btn-sm">' +
                                '<i class="fas fa-exclamation-triangle"></i> Phát hiện ' + result.modifiedBlocks.length + ' block bị sửa đổi!' +
                                '</a>'
                            );
                        } else {
                            // Hiển thị trạng thái bình thường
                            $('#integrityCheck').html(
                                '<a href="@Url.Action("Index", "BlockchainIntegrity")" class="btn btn-success btn-sm">' +
                                '<i class="fas fa-check-circle"></i> Blockchain hợp lệ' +
                                '</a>'
                            );
                        }
                    },
                    error: function() {
                        console.error('Không thể kiểm tra tính toàn vẹn blockchain');
                    }
                });
            }
            
            // Kiểm tra ngay khi trang được tải
            checkBlockchainIntegrity();
            
            // Thiết lập kiểm tra định kỳ
            setInterval(checkBlockchainIntegrity, 30000);
        });
    </script>
    
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
