@model IEnumerable<Quanlydiem.Models.Transaction>
@inject Quanlydiem.Services.ImageService ImageService

@{
    ViewData["Title"] = "Danh sách ảnh trên Blockchain";
}

<div class="container">
    <div class="row mb-3">
        <div class="col">
            <h2>Quản lý ảnh trên blockchain</h2>
            <p class="lead">Danh sách các ảnh đã được lưu trong blockchain</p>
        </div>
        <div class="col-auto">
            <a asp-action="Upload" class="btn btn-primary">
                <i class="bi bi-upload"></i> Tải lên ảnh mới
            </a>
            <a asp-action="VerifyImage" class="btn btn-success">
                <i class="bi bi-search"></i> Xác minh ảnh
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            Chưa có ảnh nào được lưu trữ trong blockchain.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>Block</th>
                        <th>Mã sinh viên</th>
                        <th>Mã môn học</th>
                        <th>Ngày lưu</th>
                        <th>Dữ liệu</th>
                        <th>Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var transaction in Model)
                    {
                        <tr>
                            <td>@(transaction.Id / 100)</td>
                            <td>@transaction.masinhvien</td>
                            <td>@transaction.mamonhoc</td>
                            <td>@transaction.ngayluudiem.ToString("dd/MM/yyyy HH:mm:ss")</td>
                            <td>
                                @if (!string.IsNullOrEmpty(transaction.ImageHash))
                                {
                                    <span class="badge bg-info">Hash</span>
                                    <small class="text-muted">@transaction.ImageHash.Substring(0, 12)...</small>
                                }
                                else if (!string.IsNullOrEmpty(transaction.ImageData))
                                {
                                    <span class="badge bg-warning">Base64</span>
                                    <small class="text-muted">@transaction.ImageData.Substring(0, 12)...</small>
                                }
                            </td>
                            <td>
                                <a asp-action="Details" asp-route-blockNumber="@(transaction.Id / 100)" asp-route-transactionIndex="@(transaction.Id % 100)" class="btn btn-sm btn-info">
                                    <i class="bi bi-info-circle"></i> Chi tiết
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div> 