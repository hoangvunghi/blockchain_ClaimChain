@model List<Quanlydiem.Models.Transaction>
@inject Quanlydiem.Services.ImageService ImageService

@{
    ViewData["Title"] = "Danh sách ảnh trên Blockchain";
}

<div class="container">
    <h2 class="mt-4 mb-4">@ViewData["Title"]</h2>
    
    @if (!string.IsNullOrEmpty(TempData["SuccessMessage"] as string))
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }
    
    <div class="d-flex justify-content-between mb-4">
        <a asp-action="Upload" class="btn btn-primary">
            <i class="fas fa-upload"></i> Tải lên ảnh mới
        </a>
    </div>
    
    @if (!Model.Any())
    {
        <div class="alert alert-info">
            <i class="fas fa-info-circle"></i> Chưa có ảnh nào được lưu trữ trên blockchain.
        </div>
    }
    else
    {
        <div class="row">
            @foreach (var transaction in Model)
            {
                <div class="col-md-4 mb-4">
                    <div class="card h-100">
                        <div class="card-img-top" style="height: 200px; overflow: hidden;">
                            @if (!string.IsNullOrEmpty(transaction.ImageData))
                            {
                                string mimeType = ImageService.GetMimeType(transaction.ImageData);
                                <img src="data:@mimeType;base64,@transaction.ImageData" class="img-fluid" alt="Blockchain Image" style="object-fit: cover; width: 100%; height: 100%;">
                            }
                            else
                            {
                                <div class="text-center p-5 bg-light">
                                    <i class="fas fa-image fa-3x text-muted"></i>
                                    <p class="mt-2">Không có ảnh</p>
                                </div>
                            }
                        </div>
                        <div class="card-body">
                            <h5 class="card-title">@transaction.masinhvien</h5>
                            <p class="card-text">
                                <strong>Mã môn học:</strong> @transaction.mamonhoc<br>
                                <strong>Thời gian:</strong> @transaction.ngayluudiem.ToString("dd/MM/yyyy HH:mm")
                            </p>
                            @{
                                // Tìm block và index của transaction
                                int blockNumber = -1;
                                int transactionIndex = -1;
                                
                                foreach (var block in ViewContext.HttpContext.RequestServices.GetService<Quanlydiem.Models.BlockChain>().Blocks)
                                {
                                    for (int i = 0; i < block.Transactions.Count; i++)
                                    {
                                        if (block.Transactions[i] == transaction)
                                        {
                                            blockNumber = block.BlockNumber;
                                            transactionIndex = i;
                                            break;
                                        }
                                    }
                                    
                                    if (blockNumber != -1) break;
                                }
                            }
                            
                            @if (blockNumber != -1 && transactionIndex != -1)
                            {
                                <a asp-action="Details" asp-route-blockNumber="@blockNumber" asp-route-transactionIndex="@transactionIndex" class="btn btn-sm btn-info">
                                    <i class="fas fa-info-circle"></i> Chi tiết
                                </a>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div> 