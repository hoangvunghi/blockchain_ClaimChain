@model Quanlydiem.Models.Transaction
@inject Quanlydiem.Services.ImageService ImageService

@{
    ViewData["Title"] = "Chi tiết ảnh";
}

<div class="container">
    <div class="row">
        <div class="col-md-8 offset-md-2">
            <div class="card mt-4">
                <div class="card-header bg-primary text-white">
                    <h4>Chi tiết ảnh trên blockchain</h4>
                </div>
                <div class="card-body">
                    <div class="row mb-4">
                        <div class="col-md-6">
                            <h5>Thông tin giao dịch:</h5>
                            <ul class="list-group list-group-flush">
                                <li class="list-group-item d-flex justify-content-between">
                                    <span>Block:</span>
                                    <strong>@(Model.Id / 100)</strong>
                                </li>
                                <li class="list-group-item d-flex justify-content-between">
                                    <span>Mã sinh viên:</span>
                                    <strong>@Model.masinhvien</strong>
                                </li>
                                <li class="list-group-item d-flex justify-content-between">
                                    <span>Mã môn học:</span>
                                    <strong>@Model.mamonhoc</strong>
                                </li>
                                <li class="list-group-item d-flex justify-content-between">
                                    <span>Ngày tạo:</span>
                                    <strong>@Model.ngayluudiem.ToString("dd/MM/yyyy HH:mm:ss")</strong>
                                </li>
                            </ul>
                        </div>
                        <div class="col-md-6">
                            @if (!string.IsNullOrEmpty(Model.ImageData))
                            {
                                <div class="text-center">
                                    <h5>Hình ảnh:</h5>
                                    @Html.Raw(ImageService.CreateImageTag(Model.ImageData))
                                </div>
                            }
                            else
                            {
                                <div class="alert alert-info text-center">
                                    <h5>Chỉ lưu hash của ảnh</h5>
                                    <i class="bi bi-shield-lock" style="font-size: 3rem;"></i>
                                </div>
                            }
                        </div>
                    </div>
                    
                    @if (!string.IsNullOrEmpty(Model.ImageHash))
                    {
                        <div class="mb-4">
                            <h5>Hash SHA256 của ảnh:</h5>
                            <div class="bg-light p-3 rounded">
                                <code>@Model.ImageHash</code>
                            </div>
                            <small class="text-muted">
                                Hash này là định danh duy nhất của ảnh và được sử dụng để xác minh tính toàn vẹn của ảnh.
                            </small>
                        </div>
                    }
                    
                    <div class="mt-4">
                        <a asp-action="Index" class="btn btn-primary">Quay lại danh sách</a>
                        <a asp-action="VerifyImage" class="btn btn-outline-success">Xác minh ảnh khác</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div> 