@model Quanlydiem.Models.Transaction
@inject Quanlydiem.Services.ImageService ImageService

@{
    ViewData["Title"] = "Chi tiết ảnh";
}

<div class="container">
    <h2 class="mt-4 mb-4">@ViewData["Title"]</h2>
    
    <div class="row">
        <div class="col-md-8">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">Ảnh trên Blockchain</h5>
                </div>
                <div class="card-body text-center">
                    @if (Model.HasImage && !string.IsNullOrEmpty(Model.ImageData))
                    {
                        string mimeType = ImageService.GetMimeType(Model.ImageData);
                        <img src="data:@mimeType;base64,@Model.ImageData" class="img-fluid" alt="Blockchain Image">
                    }
                    else
                    {
                        <div class="text-center p-5 bg-light">
                            <i class="fas fa-image fa-5x text-muted"></i>
                            <p class="mt-3">Không có ảnh</p>
                        </div>
                    }
                </div>
            </div>
        </div>
        
        <div class="col-md-4">
            <div class="card">
                <div class="card-header bg-info text-white">
                    <h5 class="mb-0">Thông tin</h5>
                </div>
                <div class="card-body">
                    <dl class="row">
                        <dt class="col-sm-5">Mã sinh viên:</dt>
                        <dd class="col-sm-7">@Model.masinhvien</dd>
                        
                        <dt class="col-sm-5">Mã môn học:</dt>
                        <dd class="col-sm-7">@Model.mamonhoc</dd>
                        
                        <dt class="col-sm-5">Thời gian:</dt>
                        <dd class="col-sm-7">@Model.ngayluudiem.ToString("dd/MM/yyyy HH:mm")</dd>
                        
                        @{
                            // Tìm block và transaction hash
                            string blockHash = "Không xác định";
                            int blockNumber = -1;
                            
                            foreach (var block in ViewContext.HttpContext.RequestServices.GetService<Quanlydiem.Models.BlockChain>().Blocks)
                            {
                                foreach (var tx in block.Transactions)
                                {
                                    if (tx == Model)
                                    {
                                        blockHash = block.BlockHash;
                                        blockNumber = block.BlockNumber;
                                        break;
                                    }
                                }
                                
                                if (blockNumber != -1) break;
                            }
                        }
                        
                        <dt class="col-sm-5">Block:</dt>
                        <dd class="col-sm-7">#@blockNumber</dd>
                        
                        <dt class="col-sm-5">Transaction Hash:</dt>
                        <dd class="col-sm-7">
                            <small class="text-break">@Model.CalculateTransactionHash()</small>
                        </dd>
                    </dl>
                </div>
            </div>
            
            <div class="mt-3">
                <a asp-action="Index" class="btn btn-secondary">
                    <i class="fas fa-arrow-left"></i> Quay lại danh sách
                </a>
            </div>
        </div>
    </div>
</div> 