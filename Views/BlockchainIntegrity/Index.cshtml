@model List<Quanlydiem.Services.BlockIntegrityResult>

@{
    ViewData["Title"] = "Kiểm tra tính toàn vẹn Blockchain";
}

<h1>@ViewData["Title"]</h1>

<div class="row mb-4">
    <div class="col-md-12">
        <div class="card">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0">Tổng quan về tính toàn vẹn</h5>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-4 text-center">
                        <h3>@ViewBag.TotalBlocks</h3>
                        <p>Tổng số block</p>
                    </div>
                    <div class="col-md-4 text-center">
                        <h3 class="@(ViewBag.ModifiedBlocksCount > 0 ? "text-danger" : "text-success")">
                            @ViewBag.ModifiedBlocksCount
                        </h3>
                        <p>Block bị sửa đổi</p>
                    </div>
                    <div class="col-md-4 text-center">
                        <h3 class="@(ViewBag.IntegrityPercentage == 100 ? "text-success" : "text-warning")">
                            @ViewBag.IntegrityPercentage.ToString("0.00")%
                        </h3>
                        <p>Độ toàn vẹn</p>
                    </div>
                </div>

                @if (Model.Count == 0)
                {
                    <div class="alert alert-success mt-3">
                        <i class="fas fa-check-circle"></i> Tất cả các block đều hợp lệ. Dữ liệu blockchain không bị sửa đổi.
                    </div>
                }
                else
                {
                    <div class="alert alert-danger mt-3">
                        <i class="fas fa-exclamation-triangle"></i> Phát hiện <strong>@Model.Count block</strong> đã bị sửa đổi! 
                        Dữ liệu blockchain đã bị can thiệp trái phép.
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@if (Model.Count > 0)
{
    <div class="row">
        <div class="col-md-12">
            <div class="card">
                <div class="card-header bg-danger text-white">
                    <h5 class="mb-0">Danh sách các Block bị sửa đổi</h5>
                </div>
                <div class="card-body">
                    <div class="alert alert-warning">
                        <i class="fas fa-info-circle"></i> <strong>Lưu ý:</strong> Hệ thống chỉ có thể phát hiện block bị sửa đổi thông qua Merkle root, 
                        nhưng không thể xác định chính xác giao dịch nào trong block đã bị sửa đổi.
                    </div>
                    <div class="table-responsive">
                        <table class="table table-striped table-bordered">
                            <thead>
                                <tr>
                                    <th>Block Number</th>
                                    <th>Merkle Root lưu trữ</th>
                                    <th>Merkle Root hiện tại</th>
                                    <th>Trạng thái giao dịch</th>
                                    <th>Chi tiết</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var result in Model)
                                {
                                    <tr>
                                        <td>@result.BlockNumber</td>
                                        <td>
                                            <span class="text-primary d-inline-block text-truncate" style="max-width: 200px;" 
                                                title="@result.StoredMerkleRoot">
                                                @result.StoredMerkleRoot
                                            </span>
                                        </td>
                                        <td>
                                            <span class="text-danger d-inline-block text-truncate" style="max-width: 200px;"
                                                title="@result.CalculatedMerkleRoot">
                                                @result.CalculatedMerkleRoot
                                            </span>
                                        </td>
                                        <td>
                                            <span class="badge badge-warning">Không xác định cụ thể</span>
                                        </td>
                                        <td>
                                            <a asp-action="BlockDetails" asp-route-blockNumber="@result.BlockNumber" 
                                               class="btn btn-sm btn-info">
                                                <i class="fas fa-info-circle"></i> Chi tiết
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script>
        // Script để tự động cập nhật trạng thái mỗi 30 giây
        $(document).ready(function() {
            setInterval(function() {
                $.ajax({
                    url: '@Url.Action("GetBlockchainIntegrityStatus")',
                    type: 'GET',
                    success: function(result) {
                        if (!result.isValid && result.modifiedBlocks.length > 0) {
                            // Nếu phát hiện thay đổi mới, làm mới trang
                            location.reload();
                        }
                    }
                });
            }, 30000);
        });
    </script>
} 