@model Quanlydiem.Services.BlockIntegrityResult
@using Quanlydiem.Interfaces

@{
    ViewData["Title"] = $"Chi tiết Block #{Model.BlockNumber}";
}

<h1>@ViewData["Title"]</h1>

<div class="row mb-4">
    <div class="col-md-12">
        <a asp-action="Index" class="btn btn-secondary">
            <i class="fas fa-arrow-left"></i> Quay lại danh sách
        </a>
    </div>
</div>

<div class="row mb-4">
    <div class="col-md-12">
        <div class="card">
            <div class="card-header @(Model.IsValid ? "bg-success" : "bg-danger") text-white">
                <h5 class="mb-0">Thông tin Block</h5>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="font-weight-bold">Block Number:</label>
                            <p>@Model.BlockNumber</p>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="font-weight-bold">Trạng thái:</label>
                            @if (Model.IsValid)
                            {
                                <p class="text-success"><i class="fas fa-check-circle"></i> Hợp lệ</p>
                            }
                            else
                            {
                                <p class="text-danger"><i class="fas fa-exclamation-triangle"></i> Đã bị sửa đổi</p>
                            }
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-12">
                        <div class="form-group">
                            <label class="font-weight-bold">Merkle Root ban đầu (đã lưu):</label>
                            <p class="text-break text-primary">@Model.StoredMerkleRoot</p>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-12">
                        <div class="form-group">
                            <label class="font-weight-bold">Merkle Root hiện tại (tính toán lại):</label>
                            <p class="text-break @(!Model.IsValid ? "text-danger" : "text-success")">@Model.CalculatedMerkleRoot</p>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-12">
                        <div class="alert alert-info">
                            <i class="fas fa-info-circle"></i> <strong>Giải thích:</strong> Merkle root là một hash duy nhất đại diện cho tất cả
                            các giao dịch trong block. Nếu có bất kỳ giao dịch nào bị sửa đổi, Merkle root tính toán lại sẽ khác với
                            Merkle root ban đầu đã lưu, cho biết dữ liệu đã bị can thiệp.
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@if (!Model.IsValid)
{
    <div class="row">
        <div class="col-md-12">
            <div class="card">
                <div class="card-header bg-warning text-dark">
                    <h5 class="mb-0">Thông tin giao dịch trong block</h5>
                </div>
                <div class="card-body">
                    @if (Model.CanDetectSpecificTransaction)
                    {
                        if (ViewBag.IntegrityWarning != null)
                        {
                            <div class="alert alert-warning">
                                <i class="fas fa-info-circle"></i> <strong>Thông báo:</strong> @ViewBag.IntegrityWarning
                            </div>
                        }
                        else if (ViewBag.HasModifiedTransactions)
                        {
                            <div class="alert alert-danger">
                                <i class="fas fa-exclamation-triangle"></i> <strong>Cảnh báo:</strong> Phát hiện 
                                <strong>@ViewBag.ModifiedTransactionsCount giao dịch</strong> đã bị sửa đổi trong block này!
                            </div>
                        }
                        else
                        {
                            <div class="alert alert-success">
                                <i class="fas fa-check-circle"></i> <strong>Thông báo:</strong> Tất cả các giao dịch trong block này đều nguyên vẹn.
                            </div>
                        }
                    }
                    else
                    {
                        <div class="alert alert-warning">
                            <i class="fas fa-exclamation-circle"></i> <strong>Lưu ý:</strong> Phát hiện block đã bị sửa đổi thông qua Merkle root.
                            Tuy nhiên, hệ thống không thể xác định chính xác giao dịch nào đã bị sửa đổi.
                        </div>
                    }
                    
                    <div class="table-responsive mt-3">
                        <table class="table table-striped table-bordered">
                            <thead>
                                <tr>
                                    <th>Vị trí</th>
                                    <th>Tổ chức cấp</th>
                                    <th>Họ tên người nhận</th>
                                    <th>Số căn cước</th>
                                    <th>Ngày cấp</th>
                                    <th>Loại tốt nghiệp</th>
                                    <th>Trạng thái</th>
                                    @if (Model.CanDetectSpecificTransaction)
                                    {
                                        <th>Chi tiết</th>
                                    }
                                </tr>
                            </thead>
                            <tbody>
                                @{
                                    var transactions = ViewBag.Transactions as List<ITransaction>;
                                    var hashDetails = ViewBag.TransactionHashDetails as List<Quanlydiem.Services.TransactionHashDetail>;
                                    
                                    if (transactions != null)
                                    {
                                        for (int i = 0; i < transactions.Count; i++)
                                        {
                                            var tx = transactions[i];
                                            var isModified = false;
                                            var hashDetail = hashDetails?.FirstOrDefault(h => h.TransactionIndex == i);
                                            
                                            if (hashDetail != null)
                                            {
                                                isModified = hashDetail.IsModified;
                                            }
                                            
                                            <tr class="@(isModified ? "table-danger" : "")">
                                                <td>@(i + 1)</td>
                                                <td>@tx.tochuccap</td>
                                                <td>@tx.hoten</td>
                                                <td>@tx.socancuoc</td>
                                                <td>@tx.ngaycap.ToString("dd/MM/yyyy HH:mm")</td>
                                                <td>@tx.loaitotnghiep</td>
                                                <td>
                                                    @if (Model.CanDetectSpecificTransaction)
                                                    {
                                                        if (isModified)
                                                        {
                                                            <span class="badge badge-danger">Đã bị sửa đổi</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="badge badge-success">Nguyên vẹn</span>
                                                        }
                                                    }
                                                    else
                                                    {
                                                        <span class="badge badge-warning">Không xác định</span>
                                                    }
                                                </td>
                                                @if (Model.CanDetectSpecificTransaction && hashDetail != null)
                                                {
                                                    <td>
                                                        @if (isModified)
                                                        {
                                                            <button type="button" class="btn btn-sm btn-outline-danger" 
                                                                    data-toggle="modal" data-target="#hashModal@(i)">
                                                                <i class="fas fa-search"></i> Xem hash
                                                            </button>
                                                            
                                                            <!-- Modal -->
                                                            <div class="modal fade" id="hashModal@(i)" tabindex="-1" role="dialog" aria-labelledby="hashModalLabel@(i)" aria-hidden="true">
                                                                <div class="modal-dialog modal-lg" role="document">
                                                                    <div class="modal-content">
                                                                        <div class="modal-header bg-danger text-white">
                                                                            <h5 class="modal-title" id="hashModalLabel@(i)">Chi tiết giao dịch bị sửa đổi</h5>
                                                                            <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                                                                                <span aria-hidden="true">&times;</span>
                                                                            </button>
                                                                        </div>
                                                                        <div class="modal-body">
                                                                            <div class="form-group">
                                                                                <label class="font-weight-bold">Thông tin giao dịch:</label>
                                                                                <p>
                                                                                    Tổ chức cấp: <strong>@tx.tochuccap</strong><br/>
                                                                                    Họ tên: <strong>@hashDetail.HoTen</strong><br/>
                                                                                    Số căn cước: <strong>@hashDetail.SoCanCuoc</strong>
                                                                                </p>
                                                                            </div>
                                                                            <div class="form-group">
                                                                                <label class="font-weight-bold">Hash ban đầu (lưu trong DB):</label>
                                                                                <div class="input-group">
                                                                                    <input type="text" class="form-control text-primary" value="@hashDetail.OriginalHash" readonly>
                                                                                    <div class="input-group-append">
                                                                                        <button class="btn btn-outline-secondary copy-hash-btn" data-hash="@hashDetail.OriginalHash" type="button">
                                                                                            <i class="fas fa-copy"></i> Copy
                                                                                        </button>
                                                                                    </div>
                                                                                </div>
                                                                            </div>
                                                                            <div class="form-group">
                                                                                <label class="font-weight-bold">Hash hiện tại (tính toán lại):</label>
                                                                                <div class="input-group">
                                                                                    <input type="text" class="form-control text-danger" value="@hashDetail.CurrentHash" readonly>
                                                                                    <div class="input-group-append">
                                                                                        <button class="btn btn-outline-secondary copy-hash-btn" data-hash="@hashDetail.CurrentHash" type="button">
                                                                                            <i class="fas fa-copy"></i> Copy
                                                                                        </button>
                                                                                    </div>
                                                                                </div>
                                                                            </div>
                                                                            <div class="alert alert-warning">
                                                                                <i class="fas fa-info-circle"></i> Giao dịch này đã bị sửa đổi sau khi được thêm vào blockchain.
                                                                                Hash hiện tại (tính toán từ dữ liệu hiện tại) khác với hash ban đầu (đã lưu trong DB lúc tạo giao dịch).
                                                                                Điều này có thể là dấu hiệu của việc can thiệp trái phép vào dữ liệu.
                                                                            </div>
                                                                        </div>
                                                                        <div class="modal-footer">
                                                                            <button type="button" class="btn btn-secondary" data-dismiss="modal">Đóng</button>
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        }
                                                        else
                                                        {
                                                            <span class="text-muted">-</span>
                                                        }
                                                    </td>
                                                }
                                            </tr>
                                        }
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script>
        $(document).ready(function() {
            // Xử lý copy hash
            $('.copy-hash-btn').click(function() {
                var hashText = $(this).data('hash');
                var tempInput = $('<input>');
                $('body').append(tempInput);
                tempInput.val(hashText).select();
                document.execCommand('copy');
                tempInput.remove();
                
                // Đổi biểu tượng trong 1.5 giây
                var $icon = $(this).find('i');
                var originalClass = $icon.attr('class');
                $icon.attr('class', 'fas fa-check');
                
                setTimeout(function() {
                    $icon.attr('class', originalClass);
                }, 1500);
            });
        });
    </script>
}