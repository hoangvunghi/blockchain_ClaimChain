@model Quanlydiem.Models.EditTransactionViewModel

@{
    ViewData["Title"] = "Chỉnh sửa giao dịch";
}

<div class="container">
    <h2 class="mt-4 mb-4">@ViewData["Title"]</h2>
    
    <div class="row">
        <div class="col-md-8 offset-md-2">
            <div class="card shadow">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">Cập nhật thông tin giao dịch</h5>
                    <small class="d-block mt-1">Block #@Model.BlockNumber - Transaction #@Model.TransactionId</small>
                </div>
                <div class="card-body">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <form asp-action="EditTransaction" method="post" enctype="multipart/form-data">
                        <input type="hidden" asp-for="BlockNumber" />
                        <input type="hidden" asp-for="TransactionId" />
                        <input type="hidden" asp-for="ImageData" />
                        <input type="hidden" asp-for="HasImage" />
                        
                        <div class="row mb-3">
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label asp-for="MaSinhVien" class="control-label"></label>
                                    <input asp-for="MaSinhVien" class="form-control" />
                                    <span asp-validation-for="MaSinhVien" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label asp-for="MaMonHoc" class="control-label"></label>
                                    <input asp-for="MaMonHoc" class="form-control" />
                                    <span asp-validation-for="MaMonHoc" class="text-danger"></span>
                                </div>
                            </div>
                        </div>
                        
                        <div class="row mb-3">
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label asp-for="Diem" class="control-label"></label>
                                    <input asp-for="Diem" class="form-control" min="0" max="10" />
                                    <span asp-validation-for="Diem" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label asp-for="NgayLuuDiem" class="control-label"></label>
                                    <input asp-for="NgayLuuDiem" class="form-control" type="datetime-local" />
                                    <span asp-validation-for="NgayLuuDiem" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label asp-for="DiemLanThu" class="control-label"></label>
                                    <input asp-for="DiemLanThu" class="form-control" min="1" max="10" />
                                    <span asp-validation-for="DiemLanThu" class="text-danger"></span>
                                </div>
                            </div>
                        </div>
                        
                        <div class="row mb-3">
                            <div class="col-md-12">
                                <div class="form-group">
                                    <label for="imageFile" class="control-label">Ảnh bài thi</label>
                                    <input type="file" id="imageFile" name="imageFile" class="form-control" accept="image/*" />
                                    <small class="form-text text-muted">
                                        Hỗ trợ định dạng: JPEG, PNG, GIF, WEBP. Kích thước tối đa: 5MB.
                                        Để trống nếu không muốn thay đổi ảnh.
                                    </small>
                                </div>
                                
                                @if (Model.HasImage && !string.IsNullOrEmpty(Model.ImageData))
                                {
                                    <div class="mt-3">
                                        <h6>Ảnh hiện tại:</h6>
                                        @{
                                            string mimeType = "image/jpeg"; // Mặc định
                                            if (Model.ImageData.StartsWith("/9j/")) mimeType = "image/jpeg";
                                            if (Model.ImageData.StartsWith("iVBORw0Kg")) mimeType = "image/png";
                                            if (Model.ImageData.StartsWith("R0lGODlh")) mimeType = "image/gif";
                                            if (Model.ImageData.StartsWith("UklGR")) mimeType = "image/webp";
                                        }
                                        <img src="data:@mimeType;base64,@Model.ImageData" class="img-fluid mt-2" style="max-height: 200px;" />
                                        
                                        <div class="form-check mt-2">
                                            <input class="form-check-input" type="checkbox" id="removeImage" name="removeImage" value="true">
                                            <label class="form-check-label" for="removeImage">
                                                Xóa ảnh này
                                            </label>
                                        </div>
                                    </div>
                                }
                                
                                <div class="mt-3">
                                    <div class="image-preview-container" style="display: none;">
                                        <h6>Xem trước ảnh mới:</h6>
                                        <img id="image-preview" class="img-fluid mt-2" style="max-height: 200px;" />
                                    </div>
                                </div>
                            </div>
                        </div>
                        
                        <div class="d-flex justify-content-between mt-4">
                            <a asp-action="Index" class="btn btn-secondary">
                                <i class="bi bi-arrow-left"></i> Quay lại
                            </a>
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-save"></i> Cập nhật
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            // Hiển thị xem trước ảnh khi chọn file
            $('#imageFile').change(function() {
                if (this.files && this.files[0]) {
                    var reader = new FileReader();
                    
                    reader.onload = function(e) {
                        $('#image-preview').attr('src', e.target.result);
                        $('.image-preview-container').show();
                    }
                    
                    reader.readAsDataURL(this.files[0]);
                    
                    // Kiểm tra kích thước file
                    var fileSize = this.files[0].size; // Bytes
                    var maxSize = 5 * 1024 * 1024; // 5MB
                    
                    if (fileSize > maxSize) {
                        alert('Kích thước ảnh quá lớn. Vui lòng chọn ảnh dưới 5MB.');
                        this.value = '';
                        $('.image-preview-container').hide();
                    }
                }
            });
            
            // Xử lý tùy chọn xóa ảnh
            $('#removeImage').change(function() {
                if ($(this).is(':checked')) {
                    $('input[name="HasImage"]').val(false);
                } else {
                    $('input[name="HasImage"]').val(true);
                }
            });
        });
    </script>
} 