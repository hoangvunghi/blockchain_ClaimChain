@model BlockchainViewModel

<!-- 
HƯỚNG DẪN THAY ĐỔI THUỘC TÍNH:
Trong file này, có 5 thuộc tính chính có thể được thay đổi:
1. tochuccap/tochuccap: Hiện tại là "Mã sinh viên", có thể thay đổi thành thuộc tính khác
2. hoten/hoten: Hiện tại là "Mã môn học", có thể thay đổi thành thuộc tính khác
3. diem/Diem: Hiện tại là "Điểm", có thể thay đổi thành thuộc tính khác
4. ngaycap/ngaycap: Hiện tại là "Ngày cấp", có thể thay đổi thành thuộc tính khác
5. diemlanthu/DiemLanThu: Hiện tại là "Điểm lần thứ", có thể thay đổi thành thuộc tính khác

Các vị trí cần thay đổi đã được đánh dấu bằng chú thích "THUỘC TÍNH X" trong file.
Lưu ý: Khi thay đổi tên thuộc tính, cần thay đổi đồng bộ ở tất cả các vị trí được đánh dấu,
bao gồm cả trong phần HTML và JavaScript.
-->

<div class="container mt-5">
    <!-- Header Section -->
    <div class="text-center mb-5">
        <h1 class="display-4 fw-bold text-gradient">Blockchain Demo</h1>
        @* <p class="lead text-muted">A simple demonstration
         of blockchain technology with transactions and blocks</p> *@
        <p class="lead text-muted">Chương trình quản lý bằng tốt nghiệp</p>
    </div>

    <!-- Success Message -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
            <i class="bi bi-check-circle-fill"></i> 
            <span>@Html.Raw(TempData["SuccessMessage"])</span>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Error Message -->
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Blockchain Stats -->
    <div class="row mb-5">
        <div class="col-md-4">
            <div class="card bg-primary text-white h-100">
                <div class="card-body">
                    <h5 class="card-title">
                        <i class="bi bi-box-seam"></i> Total Blocks
                    </h5>
                    <p class="display-4 mb-0">@Model.Blockchain.Blocks.Count</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card bg-success text-white h-100">
                <div class="card-body">
                    <h5 class="card-title">
                        <i class="bi bi-clock-history"></i> Pending Transactions
                    </h5>
                    <p class="display-4 mb-0">@Model.PendingTransactions.Count / 4</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card bg-info text-white h-100">
                <div class="card-body">
                    <h5 class="card-title">
                        <i class="bi bi-calendar-check"></i> Last Block Date
                    </h5>
                    @if (Model.Blockchain.Blocks.Any())
                    {
                        <p class="display-6 mb-0">@Model.Blockchain.Blocks.Last().CreatedDate.ToString("dd/MM/yyyy HH:mm")</p>
                    }
                    else
                    {
                        <p class="display-6 mb-0">N/A</p>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Blockchain Integrity Button -->
    <div class="text-center mb-5">
        <a href="@Url.Action("GetModifiedTransactions", "Home")" class="btn btn-danger btn-lg">
            <i class="bi bi-shield-exclamation"></i> Kiểm Tra Các Transaction Đã Bị Sửa Đổi
        </a>
    </div>

    <!-- Add Transaction Form -->
    <div class="card shadow-sm mb-5">
        <div class="card-header bg-primary text-white">
            <h3 class="card-title mb-0">
                <i class="bi bi-plus-circle"></i> Add New Transaction
            </h3>
        </div>
        <div class="card-body">
            <form asp-action="AddTransaction" method="post" class="needs-validation" novalidate>
                <div class="row mb-3">
                    <div class="col-md-6">
                        <div class="form-group">
                            <!-- THUỘC TÍNH 1: Có thể thay đổi "Mã sinh viên" và "tochuccap" -->
                            <label for="tochuccap" class="form-label">Tổ chức cấp</label>
                            <input type="text" class="form-control" id="tochuccap" name="tochuccap" required>
                            <div class="invalid-feedback">
                                Vui lòng nhập tổ chức cấp
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <!-- THUỘC TÍNH 2: Có thể thay đổi "Mã môn học" và "hoten" -->
                            <label for="hoten" class="form-label">Họ tên người nhận</label>
                            <input type="text" class="form-control" id="hoten" name="hoten" required>
                            <div class="invalid-feedback">
                                Vui lòng nhập họ tên người nhận
                            </div>
                        </div>
                    </div>
                </div>
                <div class="row mb-3">
                    <div class="col-md-4">
                        <div class="form-group">
                            <!-- THUỘC TÍNH 3: Có thể thay đổi "Điểm" và "diem" -->
                            <label for="socancuoc" class="form-label">Số căn cước</label>
                            <input type="text" class="form-control" id="socancuoc" name="socancuoc" required>
                            <div class="invalid-feedback">
                                Vui lòng nhập số căn cước.
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-group">
                            <!-- THUỘC TÍNH 4: Có thể thay đổi "Ngày cấp" và "ngaycap" -->
                            <label for="ngaycap" class="form-label">Ngày cấp</label>
                            <input type="datetime-local" class="form-control" id="ngaycap" name="ngaycap" required>
                            <div class="invalid-feedback">
                                Vui lòng chọn ngày cấp.
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-group">
                            <!-- THUỘC TÍNH 5: Có thể thay đổi "Điểm lần thứ" và "diemlanthu" -->
                            <label for="loaitotnghiep" class="form-label">Loại tốt nghiệp</label>
                            <select id="loaitotnghiep" name="loaitotnghiep" class="form-select rounded-3" asp-items="Html.GetEnumSelectList<Quanlydiem.Interfaces.LoaiTotNghiep>()" required>
                            <option value="">-- Chọn loại tốt nghiệp --</option>
                        </select>
                            <div class="invalid-feedback">
                                Vui lòng chọn loại tốt nghiệp.
                            </div>
                        </div>
                    </div>
                </div>
                <div class="text-center">
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-plus-circle"></i> Add Transaction
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Blockchain Blocks -->
    <div class="card shadow-sm mb-5">
        <div class="card-header bg-primary text-white">
            <h3 class="card-title mb-0">
                <i class="bi bi-box-seam"></i> Blockchain Blocks
            </h3>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead class="table-light">
                        <tr>
                            <th>Block #</th>
                            <th>Created Date</th>
                            <th>Transactions</th>
                            <th>Block Hash</th>
                            <th>Previous Block Hash</th>
                            <th>Merkle Root</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var block in Model.Blockchain.Blocks.OrderByDescending(b => b.BlockNumber))
                        {
                            <tr class="block-row" 
                                data-block-number="@block.BlockNumber" 
                                data-block-hash="@block.BlockHash" 
                                data-previous-hash="@block.PreviousBlockHash" 
                                data-created-date="@block.CreatedDate.ToString("yyyy-MM-dd HH:mm:ss")"
                                data-merkle-root="@block.MerkleRoot"
                                data-transactions="@Html.Raw(System.Text.Json.JsonSerializer.Serialize(block.Transactions.Select((t, i) => new { 
                                    id = i + 1, 
                                    /* THUỘC TÍNH 1: Có thể thay đổi tochuccap */
                                    tochuccap = t.tochuccap, 
                                    /* THUỘC TÍNH 2: Có thể thay đổi hoten */
                                    hoten = t.hoten, 
                                    /* THUỘC TÍNH 3: Có thể thay đổi diem */
                                    socancuoc = t.socancuoc, 
                                    /* THUỘC TÍNH 4: Có thể thay đổi ngaycap */
                                    ngaycap = t.ngaycap,
                                    /* THUỘC TÍNH 5: Có thể thay đổi diemlanthu */
                                    loaitotnghiep = t.loaitotnghiep
                                })))">
                                <td>@block.BlockNumber</td>
                                <td>@block.CreatedDate.ToString("dd/MM/yyyy HH:mm:ss")</td>
                                <td>@block.Transactions.Count</td>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <span class="text-truncate" style="max-width: 150px;">@block.BlockHash</span>
                                        <button class="btn btn-sm btn-outline-secondary ms-2 copy-btn" 
                                                data-clipboard-text="@block.BlockHash" 
                                                title="Copy to clipboard">
                                            <i class="bi bi-clipboard"></i>
                                        </button>
                                    </div>
                                </td>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <span class="text-truncate" style="max-width: 150px;">@block.PreviousBlockHash</span>
                                        <button class="btn btn-sm btn-outline-secondary ms-2 copy-btn" 
                                                data-clipboard-text="@block.PreviousBlockHash" 
                                                title="Copy to clipboard">
                                            <i class="bi bi-clipboard"></i>
                                        </button>
                                    </div>
                                </td>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <span class="text-truncate" style="max-width: 150px;">@block.MerkleRoot</span>
                                        <button class="btn btn-sm btn-outline-secondary ms-2 copy-btn" 
                                                data-clipboard-text="@block.MerkleRoot" 
                                                title="Copy to clipboard">
                                            <i class="bi bi-clipboard"></i>
                                        </button>
                                    </div>
                                </td>
                                <td>
                                    <button class="btn btn-sm btn-primary view-block-btn" data-bs-toggle="collapse" data-bs-target="#transactions-@block.BlockNumber" aria-expanded="false" aria-controls="transactions-@block.BlockNumber">
                                        <i class="bi bi-eye"></i> View
                                    </button>
                                </td>
                            </tr>
                            <tr class="transaction-details-row">
                                <td colspan="7" class="p-0">
                                    <div class="collapse" id="transactions-@block.BlockNumber">
                                        <div class="card card-body border-0 bg-light">
                                            <h5 class="card-title">Transactions in Block #@block.BlockNumber</h5>
                                            <div class="table-responsive">
                                                <table class="table table-sm">
                                                    <thead>
                                                        <tr>
                                                            <th>#</th>
                                                            <!-- THUỘC TÍNH 1: Có thể thay đổi "Tổ chức cấp" -->
                                                            <th>Tổ chức cấp</th>
                                                            <!-- THUỘC TÍNH 2: Có thể thay đổi "Họ và tên" -->
                                                            <th>Họ và tên</th>
                                                            <!-- THUỘC TÍNH 3: Có thể thay đổi "Điểm" -->
                                                            <th>Số căn cước</th>
                                                            <!-- THUỘC TÍNH 4: Có thể thay đổi "Ngày lưu" -->
                                                            <th>Ngày cấp</th>
                                                            <!-- THUỘC TÍNH 5: Có thể thay đổi "Lần thứ" -->
                                                            <th>Loại tốt nghiệp</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        @for (int i = 0; i < block.Transactions.Count; i++)
                                                        {
                                                            var transaction = block.Transactions[i];
                                                            var transactionId = i + 1;
                                                            <tr>
                                                                <td>@transactionId</td>
                                                                <!-- THUỘC TÍNH 1: Có thể thay đổi transaction.tochuccap -->
                                                                <td>@transaction.tochuccap</td>
                                                                <!-- THUỘC TÍNH 2: Có thể thay đổi transaction.hoten -->
                                                                <td>@transaction.hoten</td>
                                                                <!-- THUỘC TÍNH 3: Có thể thay đổi transaction.diem -->
                                                                <td>@transaction.socancuoc</td>
                                                                <!-- THUỘC TÍNH 4: Có thể thay đổi transaction.ngaycap -->
                                                                <td>@transaction.ngaycap.ToString("dd/MM/yyyy HH:mm")</td>
                                                                <!-- THUỘC TÍNH 5: Có thể thay đổi transaction.diemlanthu -->
                                                                <td>@transaction.loaitotnghiep</td>
                                                            </tr>
                                                        }
                                                    </tbody>
                                                </table>
                                            </div>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Pending Transactions -->
    <div class="card shadow-sm mb-5">
        <div class="card-header bg-success text-white">
            <h3 class="card-title mb-0">
                <i class="bi bi-clock-history"></i> Pending Transactions
            </h3>
        </div>
        <div class="card-body">
            @if (Model.PendingTransactions.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead class="table-light">
                            <tr>
                                <th>#</th>
                                <!-- THUỘC TÍNH 1: Có thể thay đổi "Tổ chức cấp" -->
                                <th>Tổ chức cấp</th>
                                <!-- THUỘC TÍNH 2: Có thể thay đổi "Họ và tên" -->
                                <th>Họ và tên</th>
                                <!-- THUỘC TÍNH 3: Có thể thay đổi "Điểm" -->
                                <th>Số căn cước</th>
                                <!-- THUỘC TÍNH 4: Có thể thay đổi "Ngày lưu" -->
                                <th>Ngày cấp</th>
                                <!-- THUỘC TÍNH 5: Có thể thay đổi "Lần thứ" -->
                                <th>Loại tốt nghiệp</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (int i = 0; i < Model.PendingTransactions.Count; i++)
                            {
                                var transaction = Model.PendingTransactions[i];
                                <tr>
                                    <td>@(i + 1)</td>
                                    <!-- THUỘC TÍNH 1: Có thể thay đổi transaction.tochuccap -->
                                    <td>@transaction.tochuccap</td>
                                    <!-- THUỘC TÍNH 2: Có thể thay đổi transaction.hoten -->
                                    <td>@transaction.hoten</td>
                                    <!-- THUỘC TÍNH 3: Có thể thay đổi transaction.diem -->
                                    <td>@transaction.socancuoc</td>
                                    <!-- THUỘC TÍNH 4: Có thể thay đổi transaction.ngaycap -->
                                    <td>@transaction.ngaycap.ToString("dd/MM/yyyy HH:mm")</td>
                                    <!-- THUỘC TÍNH 5: Có thể thay đổi transaction.diemlanthu -->
                                    <td>@transaction.loaitotnghiep</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="alert alert-info mt-3">
                    <i class="bi bi-info-circle"></i> Pending transactions will be added to a new block once there are 4 transactions.
                </div>
            }
            else
            {
                <div class="alert alert-info">
                    <i class="bi bi-info-circle"></i> No pending transactions.
                </div>
            }
        </div>
    </div>
</div>

<!-- RSA Encryption Section -->

<!-- Block Details Modal -->
<div class="modal fade" id="blockDetailsModal" tabindex="-1" aria-labelledby="blockDetailsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title" id="blockDetailsModalLabel">Block Details</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="row mb-3">
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label class="form-label fw-bold">Block Number</label>
                            <p id="modalBlockNumber" class="form-control"></p>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label class="form-label fw-bold">Created Date</label>
                            <p id="modalCreatedDate" class="form-control"></p>
                        </div>
                    </div>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-bold">Block Hash</label>
                    <p id="modalBlockHash" class="form-control"></p>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-bold">Previous Block Hash</label>
                    <p id="modalPreviousBlockHash" class="form-control"></p>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-bold">Merkle Root</label>
                    <p id="modalMerkleRoot" class="form-control"></p>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-bold">Transactions</label>
                    <div id="modalTransactions" class="list-group">
                        <!-- Transactions will be added here dynamically -->
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<!-- Error Modal -->
<div class="modal fade" id="errorModal" tabindex="-1" aria-labelledby="errorModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title" id="errorModalLabel"><i class="bi bi-check-circle-fill"></i> Thành công</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p id="errorModalMessage"></p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
            </div>
        </div>
    </div>
</div>



<style>
    .text-gradient {
        background: linear-gradient(135deg, #6366F1 0%, #4F46E5 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }
    .card {
        border: none;
        border-radius: 10px;
        transition: transform 0.2s;
    }
    .card:hover {
        transform: translateY(-5px);
    }
    .table th {
        font-weight: 600;
    }
    .form-control, .form-select {
        border-radius: 8px;
        padding: 0.75rem 1rem;
    }
    .btn {
        border-radius: 8px;
    }
    .transaction-card {
        background: linear-gradient(to right bottom, #ffffff, #f8f9fa);
    }
    .transaction-card:hover {
        box-shadow: 0 0.5rem 1rem rgba(0,0,0,0.15);
    }
    .badge {
        padding: 0.5em 0.8em;
        font-weight: 500;
    }
    code {
        background: #f8f9fa;
        padding: 0.2rem 0.4rem;
        border-radius: 4px;
    }
    /* Hiệu ứng cho block đã bị sửa đổi */
    .block-row.bg-warning {
        background-color: #ffecb5 !important;
        position: relative;
        border: 2px solid #dc3545;
    }
    .block-row.bg-warning::after {
        content: "Đã sửa đổi - Vi phạm tính toàn vẹn!";
        position: absolute;
        right: 10px;
        top: 50%;
        transform: translateY(-50%);
        background-color: #dc3545;
        color: white;
        padding: 5px 10px;
        border-radius: 5px;
        font-weight: bold;
        font-size: 0.8rem;
    }
    
    /* Hiệu ứng cho các block bị ảnh hưởng */
    .block-row.border-danger {
        border: 2px dashed #dc3545 !important;
        position: relative;
        background-color: rgba(220, 53, 69, 0.1) !important;
    }
    .badge.position-absolute {
        top: 50%;
        transform: translateY(-50%);
        z-index: 10;
        font-size: 0.75rem;
        padding: 0.5em 0.7em;
    }
    
    /* Hiệu ứng cho block khi nhấp nháy */
    .block-row.bg-danger {
        background-color: rgba(220, 53, 69, 0.5) !important;
        transition: background-color 0.3s ease;
    }
    
    /* Hiệu ứng cho thông báo cảnh báo */
    .alert-danger.shadow-lg {
        box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.3) !important;
        border-radius: 10px;
        padding: 1.5rem;
    }
    .alert-danger h4 {
        color: #721c24;
        font-weight: bold;
    }
    .alert-danger ul {
        margin-left: 1rem;
    }
    .alert-danger li {
        margin-bottom: 0.5rem;
    }
    
    /* Hiệu ứng cho modal */
    .modal-content {
        border: none;
        border-radius: 10px;
        box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.3);
    }
    .modal-header {
        border-top-left-radius: 10px;
        border-top-right-radius: 10px;
    }
    .modal-footer {
        border-bottom-left-radius: 10px;
        border-bottom-right-radius: 10px;
    }
    #blockchainViolationModal .modal-content {
        border-left: 5px solid #dc3545;
    }
    #affectedBlocksList {
        max-height: 200px;
        overflow-y: auto;
    }
    .list-group-item-danger {
        background-color: rgba(220, 53, 69, 0.1);
        color: #721c24;
        border-color: rgba(220, 53, 69, 0.2);
    }
    #restoreBlockchainBtn {
        background-color: #ffc107;
        border-color: #ffc107;
        color: #212529;
        font-weight: 500;
    }
    #restoreBlockchainBtn:hover {
        background-color: #e0a800;
        border-color: #d39e00;
    }
</style>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
    <script>
        // Form validation
        (function () {
            'use strict'
            var forms = document.querySelectorAll('.needs-validation')
            Array.prototype.slice.call(forms)
                .forEach(function (form) {
                    form.addEventListener('submit', function (event) {
                        if (!form.checkValidity()) {
                            event.preventDefault()
                            event.stopPropagation()
                        }
                        form.classList.add('was-validated')
                    }, false)
                })
        })()

        // Thêm animation khi mở/đóng transaction
        document.querySelectorAll('[data-bs-toggle="collapse"]').forEach(button => {
            button.addEventListener('click', function() {
                const icon = this.querySelector('.bi');
                if (icon) {
                    icon.classList.toggle('bi-chevron-down');
                    icon.classList.toggle('bi-chevron-up');
                }
            });
        });

        $(document).ready(function() {
            // Biến lưu trữ dữ liệu ban đầu của transaction
            var originalTransactionData = {};
            
            // Xử lý sự kiện khi nhấn vào nút View
            $(".view-block-btn").click(function() {
                var row = $(this).closest(".block-row");
                var blockNumber = row.data("block-number");
                var blockHash = row.data("block-hash");
                var previousBlockHash = row.data("previous-hash");
                var createdDate = row.data("created-date");
                var merkleRoot = row.data("merkle-root");
                
                // Cập nhật thông tin trong modal
                $("#modalBlockNumber").text(blockNumber);
                $("#modalBlockHash").text(blockHash);
                $("#modalPreviousBlockHash").text(previousBlockHash);
                $("#modalCreatedDate").text(createdDate);
                $("#modalMerkleRoot").text(merkleRoot);
                
                // Xóa các transactions cũ
                $("#modalTransactions").empty();
                
                // Thêm các transactions mới
                var transactions = row.data("transactions");
                if (transactions && transactions.length > 0) {
                    transactions.forEach(function(txn) {
                        var txnHtml = `
                            <div class="list-group-item">
                                <div class="d-flex w-100 justify-content-between">
                                    <!-- THUỘC TÍNH 1: Có thể thay đổi "Sinh viên" và txn.tochuccap -->
                                    <h5 class="mb-1">Sinh viên: ${txn.tochuccap}</h5>
                                    <!-- THUỘC TÍNH 2: Có thể thay đổi "Môn học" và txn.hoten -->
                                    <small>Môn học: ${txn.hoten}</small>
                                </div>
                                <!-- THUỘC TÍNH 3: Có thể thay đổi "Điểm" và txn.diem -->
                                <p class="mb-1">Số căn cước: ${txn.socancuoc}</p>
                                <!-- THUỘC TÍNH 4 và 5: Có thể thay đổi "Ngày lưu", "Lần thứ", txn.ngaycap và txn.diemlanthu -->
                                <small>Ngày lưu: ${new Date(txn.ngaycap).toLocaleString()} | Lần thứ: ${txn.loaitotnghiep}</small>
                            </div>
                        `;
                        $("#modalTransactions").append(txnHtml);
                    });
                } else {
                    $("#modalTransactions").append('<div class="list-group-item">Không có giao dịch nào</div>');
                }
                
                // Hiển thị modal
                $("#blockDetailsModal").modal("show");
            });

            // Xử lý sự kiện khi nhấn nút copy
            $(".copy-btn").click(function() {
                var text = $(this).data("clipboard-text");
                navigator.clipboard.writeText(text).then(function() {
                    // Hiển thị thông báo thành công trong modal thay vì alert
                    $("#errorModalMessage").text("Đã sao chép vào clipboard!");
                    $("#errorModal").modal("show");
                });
            });

            // RSA Encryption Functions
            // Mã hóa dữ liệu
            $("#btnEncrypt").click(function() {
                var text = $("#encryptText").val();
                if (!text) {
                    showAlert("Vui lòng nhập dữ liệu cần mã hóa", "warning");
                    return;
                }

                $.ajax({
                    url: "@Url.Action("Encrypt", "Home")",
                    type: "POST",
                    data: { text: text },
                    success: function(response) {
                        if (response.success) {
                            $("#encryptResult").val(response.encryptedText);
                        } else {
                            showAlert(response.message, "danger");
                        }
                    },
                    error: function() {
                        showAlert("Lỗi khi thực hiện mã hóa", "danger");
                    }
                });
            });

            // Giải mã dữ liệu
            $("#btnDecrypt").click(function() {
                var encryptedText = $("#decryptText").val();
                if (!encryptedText) {
                    showAlert("Vui lòng nhập dữ liệu cần giải mã", "warning");
                    return;
                }

                $.ajax({
                    url: "@Url.Action("Decrypt", "Home")",
                    type: "POST",
                    data: { encryptedText: encryptedText },
                    success: function(response) {
                        if (response.success) {
                            $("#decryptResult").val(response.decryptedText);
                        } else {
                            showAlert(response.message, "danger");
                        }
                    },
                    error: function() {
                        showAlert("Lỗi khi thực hiện giải mã", "danger");
                    }
                });
            });

            // Ký dữ liệu
            $("#btnSign").click(function() {
                var text = $("#signText").val();
                if (!text) {
                    showAlert("Vui lòng nhập dữ liệu cần ký", "warning");
                    return;
                }

                $.ajax({
                    url: "@Url.Action("Sign", "Home")",
                    type: "POST",
                    data: { text: text },
                    success: function(response) {
                        if (response.success) {
                            $("#signResult").val(response.signature);
                        } else {
                            showAlert(response.message, "danger");
                        }
                    },
                    error: function() {
                        showAlert("Lỗi khi thực hiện ký dữ liệu", "danger");
                    }
                });
            });

            // Xác thực chữ ký
            $("#btnVerify").click(function() {
                var text = $("#verifyText").val();
                var signature = $("#verifySignature").val();
                
                if (!text || !signature) {
                    showAlert("Vui lòng nhập đầy đủ dữ liệu gốc và chữ ký", "warning");
                    return;
                }

                $.ajax({
                    url: "@Url.Action("VerifySignature", "Home")",
                    type: "POST",
                    data: { text: text, signature: signature },
                    success: function(response) {
                        if (response.success) {
                            $("#verifyResult").removeClass("d-none alert-danger alert-success");
                            if (response.isVerified) {
                                $("#verifyResult").addClass("alert-success");
                                $("#verifyResultText").html("<i class='bi bi-check-circle-fill'></i> Chữ ký hợp lệ! Dữ liệu chưa bị sửa đổi.");
                            } else {
                                $("#verifyResult").addClass("alert-danger");
                                $("#verifyResultText").html("<i class='bi bi-x-circle-fill'></i> Chữ ký không hợp lệ! Dữ liệu có thể đã bị sửa đổi.");
                            }
                        } else {
                            showAlert(response.message, "danger");
                        }
                    },
                    error: function() {
                        showAlert("Lỗi khi thực hiện xác thực chữ ký", "danger");
                    }
                });
            });

            // Hiển thị thông báo
            function showAlert(message, type) {
                $("#errorModalMessage").text(message);
                $("#errorModal .modal-header").removeClass("bg-success bg-danger bg-warning");
                $("#errorModal .modal-title i").removeClass("bi-check-circle-fill bi-exclamation-triangle-fill bi-info-circle-fill");
                
                if (type === "success") {
                    $("#errorModal .modal-header").addClass("bg-success");
                    $("#errorModal .modal-title i").addClass("bi-check-circle-fill");
                    $("#errorModal .modal-title").text(" Thành công");
                } else if (type === "danger") {
                    $("#errorModal .modal-header").addClass("bg-danger");
                    $("#errorModal .modal-title i").addClass("bi-exclamation-triangle-fill");
                    $("#errorModal .modal-title").text(" Lỗi");
                } else if (type === "warning") {
                    $("#errorModal .modal-header").addClass("bg-warning");
                    $("#errorModal .modal-title i").addClass("bi-info-circle-fill");
                    $("#errorModal .modal-title").text(" Cảnh báo");
                }
                
                $("#errorModal").modal("show");
            }
        });
    </script>
}