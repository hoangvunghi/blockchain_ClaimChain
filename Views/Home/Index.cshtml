@model BlockchainViewModel

<div class="container mt-5">
    <!-- Header Section -->
    <div class="text-center mb-5">
        <h1 class="display-4 fw-bold text-gradient">Blockchain Demo</h1>
        <p class="lead text-muted">A simple demonstration of blockchain technology with transactions and blocks</p>
    </div>

    <!-- Success Message -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
            <i class="bi bi-check-circle-fill"></i> 
            <span>@Html.Raw(TempData["SuccessMessage"])</span>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Error Message -->
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Blockchain Stats -->
    <div class="row mb-5">
        <div class="col-md-4">
            <div class="card bg-primary text-white h-100">
                <div class="card-body">
                    <h5 class="card-title">
                        <i class="bi bi-box-seam"></i> Total Blocks
                    </h5>
                    <p class="display-4 mb-0">@Model.Blockchain.Blocks.Count</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card bg-success text-white h-100">
                <div class="card-body">
                    <h5 class="card-title">
                        <i class="bi bi-clock-history"></i> Pending Transactions
                    </h5>
                    <p class="display-4 mb-0">@Model.PendingTransactions.Count / 3</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card bg-info text-white h-100">
                <div class="card-body">
                    <h5 class="card-title">
                        <i class="bi bi-calendar-check"></i> Last Block Date
                    </h5>
                    @if (Model.Blockchain.Blocks.Any())
                    {
                        <p class="display-6 mb-0">@Model.Blockchain.Blocks.Last().CreatedDate.ToString("dd/MM/yyyy HH:mm")</p>
                    }
                    else
                    {
                        <p class="display-6 mb-0">N/A</p>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Add Transaction Form -->
    <div class="card shadow-sm mb-5">
        <div class="card-header bg-primary text-white">
            <h3 class="card-title mb-0">
                <i class="bi bi-plus-circle"></i> Add New Transaction
            </h3>
        </div>
        <div class="card-body">
            <form asp-action="AddTransaction" method="post" class="needs-validation" novalidate>
                <div class="row mb-3">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label for="masinhvien" class="form-label">Mã sinh viên</label>
                            <input type="text" class="form-control" id="masinhvien" name="masinhvien" required>
                            <div class="invalid-feedback">
                                Vui lòng nhập mã sinh viên.
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label for="mamonhoc" class="form-label">Mã môn học</label>
                            <input type="text" class="form-control" id="mamonhoc" name="mamonhoc" required>
                            <div class="invalid-feedback">
                                Vui lòng nhập mã môn học.
                            </div>
                        </div>
                    </div>
                </div>
                <div class="row mb-3">
                    <div class="col-md-4">
                        <div class="form-group">
                            <label for="diem" class="form-label">Điểm</label>
                            <input type="number" class="form-control" id="diem" name="diem" min="0" max="10" required>
                            <div class="invalid-feedback">
                                Vui lòng nhập điểm từ 0-10.
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-group">
                            <label for="ngayluudiem" class="form-label">Ngày lưu điểm</label>
                            <input type="datetime-local" class="form-control" id="ngayluudiem" name="ngayluudiem" required>
                            <div class="invalid-feedback">
                                Vui lòng chọn ngày lưu điểm.
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-group">
                            <label for="diemlanthu" class="form-label">Điểm lần thứ</label>
                            <input type="number" class="form-control" id="diemlanthu" name="diemlanthu" min="1" max="10" value="1" required>
                            <div class="invalid-feedback">
                                Vui lòng nhập lần thi từ 1-10.
                            </div>
                        </div>
                    </div>
                </div>
                <div class="text-center">
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-plus-circle"></i> Add Transaction
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Blockchain Blocks -->
    <div class="card shadow-sm mb-5">
        <div class="card-header bg-primary text-white">
            <h3 class="card-title mb-0">
                <i class="bi bi-box-seam"></i> Blockchain Blocks
            </h3>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead class="table-light">
                        <tr>
                            <th>Block #</th>
                            <th>Created Date</th>
                            <th>Transactions</th>
                            <th>Merkle Root</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var block in Model.Blockchain.Blocks.OrderByDescending(b => b.BlockNumber))
                        {
                            <tr class="block-row" 
                                data-block-number="@block.BlockNumber" 
                                data-block-hash="@block.BlockHash" 
                                data-previous-hash="@block.PreviousBlockHash" 
                                data-created-date="@block.CreatedDate.ToString("yyyy-MM-dd HH:mm:ss")"
                                data-merkle-root="@block.MerkleRoot"
                                data-transactions="@Html.Raw(System.Text.Json.JsonSerializer.Serialize(block.Transactions.Select((t, i) => new { 
                                    id = i + 1, 
                                    masinhvien = t.masinhvien, 
                                    mamonhoc = t.mamonhoc, 
                                    diem = t.diem, 
                                    ngayluudiem = t.ngayluudiem,
                                    diemlanthu = t.diemlanthu
                                })))">
                                <td>@block.BlockNumber</td>
                                <td>@block.CreatedDate.ToString("dd/MM/yyyy HH:mm:ss")</td>
                                <td>@block.Transactions.Count</td>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <span class="text-truncate" style="max-width: 150px;">@block.MerkleRoot</span>
                                        <button class="btn btn-sm btn-outline-secondary ms-2 copy-btn" 
                                                data-clipboard-text="@block.MerkleRoot" 
                                                title="Copy to clipboard">
                                            <i class="bi bi-clipboard"></i>
                                        </button>
                                    </div>
                                </td>
                                <td>
                                    <button class="btn btn-sm btn-primary view-block-btn" data-bs-toggle="collapse" data-bs-target="#transactions-@block.BlockNumber" aria-expanded="false" aria-controls="transactions-@block.BlockNumber">
                                        <i class="bi bi-eye"></i> View
                                    </button>
                                </td>
                            </tr>
                            <tr class="transaction-details-row">
                                <td colspan="5" class="p-0">
                                    <div class="collapse" id="transactions-@block.BlockNumber">
                                        <div class="card card-body border-0 bg-light">
                                            <h5 class="card-title">Transactions in Block #@block.BlockNumber</h5>
                                            <div class="table-responsive">
                                                <table class="table table-sm">
                                                    <thead>
                                                        <tr>
                                                            <th>#</th>
                                                            <th>Mã SV</th>
                                                            <th>Mã MH</th>
                                                            <th>Điểm</th>
                                                            <th>Ngày lưu</th>
                                                            <th>Lần thứ</th>
                                                            <th>Actions</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        @for (int i = 0; i < block.Transactions.Count; i++)
                                                        {
                                                            var transaction = block.Transactions[i];
                                                            var transactionId = i + 1;
                                                            <tr>
                                                                <td>@transactionId</td>
                                                                <td>@transaction.masinhvien</td>
                                                                <td>@transaction.mamonhoc</td>
                                                                <td>@transaction.diem</td>
                                                                <td>@transaction.ngayluudiem.ToString("dd/MM/yyyy HH:mm")</td>
                                                                <td>@transaction.diemlanthu</td>
                                                                <td>
                                                                    <button class="btn btn-sm btn-warning edit-transaction-btn" 
                                                                            data-block-number="@block.BlockNumber" 
                                                                            data-transaction-id="@transactionId"
                                                                            data-masinhvien="@transaction.masinhvien"
                                                                            data-mamonhoc="@transaction.mamonhoc"
                                                                            data-diem="@transaction.diem"
                                                                            data-ngayluudiem="@transaction.ngayluudiem.ToString("yyyy-MM-ddTHH:mm")"
                                                                            data-diemlanthu="@transaction.diemlanthu">
                                                                        <i class="bi bi-pencil-square"></i> Sửa
                                        </button>
                                                                </td>
                                                            </tr>
                                                        }
                                                    </tbody>
                                                </table>
                                                        </div>
                                                    </div>
                                                </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Pending Transactions -->
    <div class="card shadow-sm mb-5">
        <div class="card-header bg-success text-white">
            <h3 class="card-title mb-0">
                <i class="bi bi-clock-history"></i> Pending Transactions
            </h3>
        </div>
        <div class="card-body">
            @if (Model.PendingTransactions.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead class="table-light">
                            <tr>
                                <th>#</th>
                                <th>Mã SV</th>
                                <th>Mã MH</th>
                                <th>Điểm</th>
                                <th>Ngày lưu</th>
                                <th>Lần thứ</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (int i = 0; i < Model.PendingTransactions.Count; i++)
                            {
                                var transaction = Model.PendingTransactions[i];
                                <tr>
                                    <td>@(i + 1)</td>
                                    <td>@transaction.masinhvien</td>
                                    <td>@transaction.mamonhoc</td>
                                    <td>@transaction.diem</td>
                                    <td>@transaction.ngayluudiem.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td>@transaction.diemlanthu</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="alert alert-info mt-3">
                    <i class="bi bi-info-circle"></i> Pending transactions will be added to a new block once there are 3 transactions.
                </div>
            }
            else
            {
                <div class="alert alert-info">
                    <i class="bi bi-info-circle"></i> No pending transactions.
                </div>
            }
        </div>
    </div>
</div>

<!-- Block Details Modal -->
<div class="modal fade" id="blockDetailsModal" tabindex="-1" aria-labelledby="blockDetailsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title" id="blockDetailsModalLabel">Block Details</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
            <div class="modal-body">
                <div class="row mb-3">
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label class="form-label fw-bold">Block Number</label>
                            <p id="modalBlockNumber" class="form-control"></p>
                    </div>
                    </div>
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label class="form-label fw-bold">Created Date</label>
                            <p id="modalCreatedDate" class="form-control"></p>
                    </div>
                    </div>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-bold">Block Hash</label>
                    <p id="modalBlockHash" class="form-control"></p>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-bold">Previous Block Hash</label>
                    <p id="modalPreviousBlockHash" class="form-control"></p>
        </div>
                <div class="mb-3">
                    <label class="form-label fw-bold">Merkle Root</label>
                    <p id="modalMerkleRoot" class="form-control"></p>
    </div>
                <div class="mb-3">
                    <label class="form-label fw-bold">Transactions</label>
                    <div id="modalTransactions" class="list-group">
                        <!-- Transactions will be added here dynamically -->
                                                </div>
                                            </div>
                                        </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

<!-- Error Modal -->
<div class="modal fade" id="errorModal" tabindex="-1" aria-labelledby="errorModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title" id="errorModalLabel"><i class="bi bi-check-circle-fill"></i> Thành công</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p id="errorModalMessage"></p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
            </div>
        </div>
    </div>
</div>

<!-- Blockchain Integrity Violation Modal -->
<div class="modal fade" id="blockchainViolationModal" tabindex="-1" aria-labelledby="blockchainViolationModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title" id="blockchainViolationModalLabel"><i class="bi bi-exclamation-triangle-fill"></i> Vi phạm tính toàn vẹn blockchain</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="alert alert-danger">
                    <h4 class="alert-heading">Cảnh báo nghiêm trọng!</h4>
                    <p>Dữ liệu đã được cập nhật nhưng điều này đã vi phạm tính toàn vẹn của chuỗi khối:</p>
                    <ul>
                        <li><strong>Hash của block hiện tại không còn chính xác</strong> - Hash của block được tính toán dựa trên dữ liệu của các transaction, khi dữ liệu thay đổi, hash sẽ thay đổi.</li>
                        <li><strong>Merkle root của block đã thay đổi</strong> - Merkle root là hash của tất cả các transaction trong block, khi một transaction thay đổi, merkle root sẽ thay đổi.</li>
                        <li><strong>Tất cả các block tiếp theo đều bị ảnh hưởng</strong> - Mỗi block chứa hash của block trước đó, khi hash của một block thay đổi, tất cả các block tiếp theo đều không còn hợp lệ.</li>
                    </ul>
                    <hr>
                    <p class="mb-0">Trong một blockchain thực tế, hành động này sẽ bị từ chối bởi các node khác trong mạng vì vi phạm tính bất biến (immutability) - một trong những đặc tính quan trọng nhất của blockchain.</p>
                </div>
                <div class="text-center mt-4">
                    <p class="text-danger fw-bold">Các block sau đã bị ảnh hưởng:</p>
                    <div id="affectedBlocksList" class="list-group">
                        <!-- Affected blocks will be added here dynamically -->
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                <button type="button" class="btn btn-warning" id="restoreBlockchainBtn">
                    <i class="bi bi-arrow-counterclockwise"></i> Khôi phục blockchain
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Edit Transaction Modal -->
<div class="modal fade" id="editTransactionModal" tabindex="-1" aria-labelledby="editTransactionModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-warning">
                <h5 class="modal-title" id="editTransactionModalLabel">Sửa Transaction</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="alert alert-warning" role="alert">
                    <h6 class="alert-heading"><i class="bi bi-exclamation-triangle-fill"></i> Cảnh báo!</h6>
                    <p class="mb-0">Việc sửa đổi dữ liệu trong blockchain sẽ vi phạm tính toàn vẹn của dữ liệu.</p>
                </div>
                
                <form id="editTransactionForm">
                    <input type="hidden" id="editBlockNumber" name="BlockNumber">
                    <input type="hidden" id="editTransactionId" name="TransactionId">
                    
                    <div class="mb-3">
                        <label for="editMaSinhVien" class="form-label">Mã sinh viên</label>
                        <input type="text" class="form-control" id="editMaSinhVien" name="MaSinhVien" required>
                                    </div>
                    
                    <div class="mb-3">
                        <label for="editMaMonHoc" class="form-label">Mã môn học</label>
                        <input type="text" class="form-control" id="editMaMonHoc" name="MaMonHoc" required>
                                    </div>
                    
                    <div class="mb-3">
                        <label for="editDiem" class="form-label">Điểm</label>
                        <input type="number" class="form-control" id="editDiem" name="Diem" min="0" max="10" required>
                                </div>
                    
                    <div class="mb-3">
                        <label for="editNgayLuuDiem" class="form-label">Ngày lưu điểm</label>
                        <input type="datetime-local" class="form-control" id="editNgayLuuDiem" name="NgayLuuDiem" required>
                            </div>
                    
                    <div class="mb-3">
                        <label for="editDiemLanThu" class="form-label">Điểm lần thứ</label>
                        <input type="number" class="form-control" id="editDiemLanThu" name="DiemLanThu" min="1" max="10" required>
                        </div>
                </form>
                </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                <button type="button" class="btn btn-primary" id="saveTransactionBtn">Lưu thay đổi</button>
                </div>
        </div>
    </div>
</div>

<style>
    .text-gradient {
        background: linear-gradient(135deg, #6366F1 0%, #4F46E5 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }
    .card {
        border: none;
        border-radius: 10px;
        transition: transform 0.2s;
    }
    .card:hover {
        transform: translateY(-5px);
    }
    .table th {
        font-weight: 600;
    }
    .form-control, .form-select {
        border-radius: 8px;
        padding: 0.75rem 1rem;
    }
    .btn {
        border-radius: 8px;
    }
    .transaction-card {
        background: linear-gradient(to right bottom, #ffffff, #f8f9fa);
    }
    .transaction-card:hover {
        box-shadow: 0 0.5rem 1rem rgba(0,0,0,0.15);
    }
    .badge {
        padding: 0.5em 0.8em;
        font-weight: 500;
    }
    code {
        background: #f8f9fa;
        padding: 0.2rem 0.4rem;
        border-radius: 4px;
    }
    /* Hiệu ứng cho block đã bị sửa đổi */
    .block-row.bg-warning {
        background-color: #ffecb5 !important;
        position: relative;
        border: 2px solid #dc3545;
    }
    .block-row.bg-warning::after {
        content: "Đã sửa đổi - Vi phạm tính toàn vẹn!";
        position: absolute;
        right: 10px;
        top: 50%;
        transform: translateY(-50%);
        background-color: #dc3545;
        color: white;
        padding: 5px 10px;
        border-radius: 5px;
        font-weight: bold;
        font-size: 0.8rem;
    }
    
    /* Hiệu ứng cho các block bị ảnh hưởng */
    .block-row.border-danger {
        border: 2px dashed #dc3545 !important;
        position: relative;
        background-color: rgba(220, 53, 69, 0.1) !important;
    }
    .badge.position-absolute {
        top: 50%;
        transform: translateY(-50%);
        z-index: 10;
        font-size: 0.75rem;
        padding: 0.5em 0.7em;
    }
    
    /* Hiệu ứng cho block khi nhấp nháy */
    .block-row.bg-danger {
        background-color: rgba(220, 53, 69, 0.5) !important;
        transition: background-color 0.3s ease;
    }
    
    /* Hiệu ứng cho thông báo cảnh báo */
    .alert-danger.shadow-lg {
        box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.3) !important;
        border-radius: 10px;
        padding: 1.5rem;
    }
    .alert-danger h4 {
        color: #721c24;
        font-weight: bold;
    }
    .alert-danger ul {
        margin-left: 1rem;
    }
    .alert-danger li {
        margin-bottom: 0.5rem;
    }
    
    /* Hiệu ứng cho modal */
    .modal-content {
        border: none;
        border-radius: 10px;
        box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.3);
    }
    .modal-header {
        border-top-left-radius: 10px;
        border-top-right-radius: 10px;
    }
    .modal-footer {
        border-bottom-left-radius: 10px;
        border-bottom-right-radius: 10px;
    }
    #blockchainViolationModal .modal-content {
        border-left: 5px solid #dc3545;
    }
    #affectedBlocksList {
        max-height: 200px;
        overflow-y: auto;
    }
    .list-group-item-danger {
        background-color: rgba(220, 53, 69, 0.1);
        color: #721c24;
        border-color: rgba(220, 53, 69, 0.2);
    }
    #restoreBlockchainBtn {
        background-color: #ffc107;
        border-color: #ffc107;
        color: #212529;
        font-weight: 500;
    }
    #restoreBlockchainBtn:hover {
        background-color: #e0a800;
        border-color: #d39e00;
    }
</style>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
    <script>
        // Form validation
        (function () {
            'use strict'
            var forms = document.querySelectorAll('.needs-validation')
            Array.prototype.slice.call(forms)
                .forEach(function (form) {
                    form.addEventListener('submit', function (event) {
                        if (!form.checkValidity()) {
                            event.preventDefault()
                            event.stopPropagation()
                        }
                        form.classList.add('was-validated')
                    }, false)
                })
        })()

        // Thêm animation khi mở/đóng transaction
        document.querySelectorAll('[data-bs-toggle="collapse"]').forEach(button => {
            button.addEventListener('click', function() {
                const icon = this.querySelector('.bi');
                if (icon) {
                    icon.classList.toggle('bi-chevron-down');
                    icon.classList.toggle('bi-chevron-up');
                }
            });
        });

        $(document).ready(function() {
            // Biến lưu trữ dữ liệu ban đầu của transaction
            var originalTransactionData = {};
            
            // Xử lý sự kiện khi nhấn vào nút View
            $(".view-block-btn").click(function() {
                var row = $(this).closest(".block-row");
                var blockNumber = row.data("block-number");
                var blockHash = row.data("block-hash");
                var previousBlockHash = row.data("previous-hash");
                var createdDate = row.data("created-date");
                var merkleRoot = row.data("merkle-root");
                
                // Cập nhật thông tin trong modal
                $("#modalBlockNumber").text(blockNumber);
                $("#modalBlockHash").text(blockHash);
                $("#modalPreviousBlockHash").text(previousBlockHash);
                $("#modalCreatedDate").text(createdDate);
                $("#modalMerkleRoot").text(merkleRoot);
                
                // Xóa các transactions cũ
                $("#modalTransactions").empty();
                
                // Thêm các transactions mới
                var transactions = row.data("transactions");
                if (transactions && transactions.length > 0) {
                    transactions.forEach(function(txn) {
                        var txnHtml = `
                            <div class="list-group-item">
                                <div class="d-flex w-100 justify-content-between">
                                    <h5 class="mb-1">Sinh viên: ${txn.masinhvien}</h5>
                                    <small>Môn học: ${txn.mamonhoc}</small>
                                </div>
                                <p class="mb-1">Điểm: ${txn.diem}</p>
                                <small>Ngày lưu: ${new Date(txn.ngayluudiem).toLocaleString()} | Lần thứ: ${txn.diemlanthu}</small>
                            </div>
                        `;
                        $("#modalTransactions").append(txnHtml);
                    });
                } else {
                    $("#modalTransactions").append('<div class="list-group-item">Không có giao dịch nào</div>');
                }
                
                // Hiển thị modal
                $("#blockDetailsModal").modal("show");
            });

            // Xử lý sự kiện khi nhấn nút sửa transaction
            $(document).on("click", ".edit-transaction-btn", function() {
                var blockNumber = $(this).data("block-number");
                var transactionId = $(this).data("transaction-id");
                var masinhvien = $(this).data("masinhvien");
                var mamonhoc = $(this).data("mamonhoc");
                var diem = $(this).data("diem");
                var ngayluudiem = $(this).data("ngayluudiem");
                var diemlanthu = $(this).data("diemlanthu");
                
                // Lưu dữ liệu ban đầu
                originalTransactionData = {
                    masinhvien: masinhvien,
                    mamonhoc: mamonhoc,
                    diem: diem,
                    ngayluudiem: ngayluudiem,
                    diemlanthu: diemlanthu
                };
                
                // Điền thông tin vào form
                $("#editBlockNumber").val(blockNumber);
                $("#editTransactionId").val(transactionId);
                $("#editMaSinhVien").val(masinhvien);
                $("#editMaMonHoc").val(mamonhoc);
                $("#editDiem").val(diem);
                $("#editNgayLuuDiem").val(ngayluudiem);
                $("#editDiemLanThu").val(diemlanthu);
                
                // Hiển thị modal
                $("#editTransactionModal").modal("show");
            });

            // Hàm kiểm tra xem dữ liệu có thay đổi không
            function isDataChanged(original, current) {
                return original.masinhvien !== current.masinhvien ||
                       original.mamonhoc !== current.mamonhoc ||
                       parseFloat(original.diem) !== parseFloat(current.diem) ||
                       original.ngayluudiem !== current.ngayluudiem ||
                       parseInt(original.diemlanthu) !== parseInt(current.diemlanthu);
            }

            // Xử lý sự kiện khi nhấn nút lưu thay đổi
            $("#saveTransactionBtn").click(function() {
                var form = $("#editTransactionForm")[0];
                
                // Kiểm tra form hợp lệ
                if (form.checkValidity()) {
                    // Lấy dữ liệu từ form
                    var blockNumber = $("#editBlockNumber").val();
                    var transactionId = $("#editTransactionId").val();
                    var masinhvien = $("#editMaSinhVien").val();
                    var mamonhoc = $("#editMaMonHoc").val();
                    var diem = $("#editDiem").val();
                    var ngayluudiem = $("#editNgayLuuDiem").val();
                    var diemlanthu = $("#editDiemLanThu").val();
                    
                    // Dữ liệu hiện tại
                    var currentData = {
                        masinhvien: masinhvien,
                        mamonhoc: mamonhoc,
                        diem: diem,
                        ngayluudiem: ngayluudiem,
                        diemlanthu: diemlanthu
                    };
                    
                    // Kiểm tra xem dữ liệu có thay đổi không
                    if (!isDataChanged(originalTransactionData, currentData)) {
                        // Nếu không có thay đổi, đóng modal và không làm gì cả
                        $("#editTransactionModal").modal("hide");
                        return;
                    }
                    
                    // Hiển thị hộp thoại xác nhận
                    var confirmMessage = "CẢNH BÁO NGHIÊM TRỌNG!\n\n";
                    confirmMessage += "Việc sửa đổi dữ liệu trong blockchain sẽ:\n";
                    confirmMessage += "1. Vi phạm tính toàn vẹn của chuỗi khối\n";
                    confirmMessage += "2. Làm thay đổi hash của block hiện tại\n";
                    confirmMessage += "3. Làm thay đổi merkle root\n";
                    confirmMessage += "4. Ảnh hưởng đến tất cả các block tiếp theo\n\n";
                    confirmMessage += "Trong một blockchain thực tế, hành động này sẽ bị từ chối.\n\n";
                    confirmMessage += "Bạn có chắc chắn muốn tiếp tục không?";
                    
                    if (confirm(confirmMessage)) {
                        // Gửi AJAX request để cập nhật transaction
                        $.ajax({
                            url: '@Url.Action("EditTransaction", "Home")',
                            type: 'POST',
                            data: {
                                BlockNumber: blockNumber,
                                TransactionId: transactionId,
                                MaSinhVien: masinhvien,
                                MaMonHoc: mamonhoc,
                                Diem: diem,
                                NgayLuuDiem: ngayluudiem,
                                DiemLanThu: diemlanthu
                            },
                            success: function(result) {
                                // Đóng modal
                                $("#editTransactionModal").modal("hide");
                                
                                // Tìm các block bị ảnh hưởng
                                var affectedBlocks = [];
                                $(`.block-row`).each(function() {
                                    var currentBlockNumber = $(this).data("block-number");
                                    if (currentBlockNumber > blockNumber) {
                                        affectedBlocks.push({
                                            blockNumber: currentBlockNumber,
                                            createdDate: $(this).data("created-date")
                                        });
                                    }
                                });
                                
                                // Hiển thị danh sách các block bị ảnh hưởng
                                $("#affectedBlocksList").empty();
                                if (affectedBlocks.length > 0) {
                                    affectedBlocks.forEach(function(block) {
                                        var date = new Date(block.createdDate);
                                        var formattedDate = date.toLocaleString();
                                        $("#affectedBlocksList").append(`
                                            <div class="list-group-item list-group-item-danger d-flex justify-content-between align-items-center">
                                                <div>
                                                    <strong>Block #${block.blockNumber}</strong>
                                                </div>
                                                <div>
                                                    <span class="badge bg-secondary">${formattedDate}</span>
                                                </div>
                                            </div>
                                        `);
                                    });
                                } else {
                                    $("#affectedBlocksList").append(`
                                        <div class="list-group-item">Không có block nào bị ảnh hưởng</div>
                                    `);
                                }
                                
                                // Hiển thị modal cảnh báo vi phạm tính toàn vẹn
                                $("#blockchainViolationModal").modal("show");
                                
                                // Thêm hiệu ứng highlight cho block đã sửa
                                setTimeout(function() {
                                    // Tìm block row tương ứng
                                    var blockRow = $(`.block-row[data-block-number="${blockNumber}"]`);
                                    if (blockRow.length) {
                                        // Thêm class highlight
                                        blockRow.addClass('bg-warning');
                                        
                                        // Thêm hiệu ứng nhấp nháy
                                        var flashCount = 0;
                                        var flashInterval = setInterval(function() {
                                            blockRow.toggleClass('bg-danger');
                                            flashCount++;
                                            if (flashCount >= 6) { // Nhấp nháy 3 lần
                                                clearInterval(flashInterval);
                                                blockRow.removeClass('bg-danger').addClass('bg-warning');
                                            }
                                        }, 500);
                                    }
                                }, 500);
                                
                                // Đánh dấu các block tiếp theo cũng bị ảnh hưởng
                                setTimeout(function() {
                                    // Tìm tất cả các block có số lớn hơn block hiện tại
                                    $(`.block-row`).each(function() {
                                        var currentBlockNumber = $(this).data("block-number");
                                        if (currentBlockNumber > blockNumber) {
                                            // Thêm class và thông báo
                                            $(this).addClass('bg-light border-danger');
                                            $(this).append('<span class="badge bg-danger position-absolute end-0 me-5">Bị ảnh hưởng</span>');
                                        }
                                    });
                                }, 1000);
                            },
                            error: function(xhr) {
                                // Hiển thị thông báo lỗi trong modal thay vì alert
                                $("#errorModalMessage").text("Có lỗi xảy ra khi cập nhật transaction: " + xhr.responseText);
                                $("#errorModal").modal("show");
                            }
                        });
                    }
                } else {
                    // Hiển thị validation errors
                    $(form).addClass('was-validated');
                }
            });
            
            // Xử lý sự kiện khi nhấn nút copy
            $(".copy-btn").click(function() {
                var text = $(this).data("clipboard-text");
                navigator.clipboard.writeText(text).then(function() {
                    // Hiển thị thông báo thành công trong modal thay vì alert
                    $("#errorModalMessage").text("Đã sao chép vào clipboard!");
                    $("#errorModal").modal("show");
                });
            });
            
            // Xử lý sự kiện khi nhấn nút khôi phục blockchain
            $("#restoreBlockchainBtn").click(function() {
                // Hiển thị hiệu ứng loading
                $(this).html('<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> Đang khôi phục...');
                $(this).prop('disabled', true);
                
                // Giả lập quá trình khôi phục (chỉ để hiển thị)
                setTimeout(function() {
                    // Đóng modal
                    $("#blockchainViolationModal").modal("hide");
                    
                    // Hiển thị thông báo thành công
                    $("#errorModalMessage").html('<i class="bi bi-check-circle-fill text-success"></i> Blockchain đã được khôi phục thành công!');
                    $("#errorModal").modal("show");
                    
                    // Tải lại trang sau khi đóng modal
                    $("#errorModal").on('hidden.bs.modal', function () {
                        location.reload();
                    });
                }, 2000);
            });
        });
    </script>
}